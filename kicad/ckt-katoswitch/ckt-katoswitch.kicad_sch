	(text "THREE MODES\n\n1. Momentary\nPushbuttons or momentary toggle\nfrom 1-2 and 3-2.  Push 1-2 for \nnormal, push 3-2 for reverse.\n\n2. Logic Level\nSPST or logic level on 1, grounded on\n2.  Open (high) is normal, grounded (low)\nis reverse\n\n3. Isolated\nBOM option.  Install R3/D8/U4, DNI R4/R5.\nAllows for isolated drive, such as from\nDCC switch decoders or maybe DCC directly."
		(exclude_from_sim no)
		(at 22.86 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6c9a7654-c808-47d0-86df-f48951b16c5d")
	)
	(text "Option Jumpers\nJP1 - Momentary vs. Level\nJP2 - Reserved\nJP3 - Reserved"
		(exclude_from_sim no)
